# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

# ── Security headers (all routes) ──────────────────────────────
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block

# ── Long-term caching for Vite's hashed build assets ───────────
# Vite fingerprints filenames in /assets (e.g. index.a1b2c3d4.js),
# so it's safe to cache these forever — a new deploy ships new
# filenames automatically.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── Static site assets (icons, sprites, images) ────────────────
/favicon.ico
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=604800
/*.webp
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/sprites/*
  Cache-Control: public, max-age=604800

# ── HTML: always revalidate so users get the latest deploy ─────
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ── SEO / crawler files ─────────────────────────────────────────
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml
